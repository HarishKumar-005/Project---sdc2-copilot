# ── LLM Provider API Keys ──────────────────────────────
# Primary: Google Gemini (via google-genai SDK)
GEMINI_API_KEY=

# Fallback: Groq
GROQ_API_KEY=

# Optional fallback: OpenRouter (deferred for MVP)
OPENROUTER_API_KEY=

# ── LLM Settings ──────────────────────────────────────
# Which provider to use first: gemini | groq | template
LLM_PROVIDER=gemini
# Gemini primary model (default: gemini-3.8-flash)
# Official docs: https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.8-flash
# Gemini fallback models (comma-separated, tried in order if primary fails)
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash

# ── App Settings ──────────────────────────────────────
APP_ENV=development
DEFAULT_TIMEZONE=UTC