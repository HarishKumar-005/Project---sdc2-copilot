# ── LLM Provider API Keys ──────────────────────────────
# Primary: Google Gemini (via google-genai SDK)
GEMINI_API_KEY=

# Fallback: Groq
GROQ_API_KEY=

# Optional fallback: OpenRouter (deferred for MVP)
OPENROUTER_API_KEY=

# ── LLM Settings ──────────────────────────────────────
# Which provider to use first: gemini | groq | template
LLM_PROVIDER=gemini
# Gemini primary model (default: gemini-3.8-flash)
# Official docs: https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.8-flash
# Gemini fallback models (comma-separated, tried in order if primary fails)
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash

# ── App Settings ──────────────────────────────────────
APP_ENV=development
DEFAULT_TIMEZONE=UTC
# For deployed Streamlit Community Cloud (e.g. https://your-app.streamlit.app)
STREAMLIT_APP_URL=


# ── Database & Supabase Settings (V2) ─────────────────
# PostgreSQL connection string (direct or Supabase connection pooler)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
DB_POOL_MIN=1
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT=10.0

# Supabase Auth & Storage Settings
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SECRET_KEY=your-supabase-secret-key

# Operational API Settings (V2.6)
API_BASE_URL=http://localhost:8000
API_HOST=0.0.0.0
API_PORT=8000
RECOVERY_OPERATOR_EMAILS=operator@example.com,admin@example.com

# ── Incremental Ingestion Worker Settings (V2.2) ──────
INGESTION_ENABLED=true
INGESTION_BATCH_SIZE=50
INGESTION_POLL_INTERVAL_SECONDS=15.0
INGESTION_SOURCE_NAME=inventory
INGESTION_TABLE_NAME=inventory_source
INGESTION_RETRY_COUNT=3
INGESTION_RETRY_BACKOFF_SECONDS=2.0

# ── Deterministic Change Significance & Guardrail (V2.3) ──
GUARDRAIL_ENABLED=true
GUARDRAIL_MAX_CHANGED_RECORDS=25
GUARDRAIL_MAX_AFFECTED_POPULATION_RATIO=0.80
GUARDRAIL_MIN_EVALUATED_RECORDS_FOR_RATIO=10
GUARDRAIL_MAX_QUANTITY_RELATIVE_CHANGE=3.0
GUARDRAIL_MIN_ABSOLUTE_QUANTITY_CHANGE=50
GUARDRAIL_MAX_DEACTIVATION_COUNT=5
GUARDRAIL_MAX_CHANGES_PER_SECOND=50.0
GUARDRAIL_MIN_VELOCITY_RECORDS=10
GUARDRAIL_MAX_WAREHOUSES_AFFECTED=5