# ==============================================================================
# SCD2 Copilot — Production Git Ignore Policy
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Byte-compiled / optimized / DLL files
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# ------------------------------------------------------------------------------
# 2. Virtual Environments & Packaging
# ------------------------------------------------------------------------------
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
.pip-cache/
pip-log.txt
pip-delete-this-directory.txt

# ------------------------------------------------------------------------------
# 3. Environment Variables, Secrets & Credentials (NEVER COMMIT)
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
.envrc
.streamlit/secrets.toml
secrets/
*.pem
*.key
*.cert
*.crt

# ------------------------------------------------------------------------------
# 4. SCD2 Application Data, Run Artifacts, Staging & Quarantine
# ------------------------------------------------------------------------------
# Persisted Runs & Artifact manifests
runs/
data/runs/
data/quarantine/
data/staging/
quarantine/
staging/

# Output datasets & intermediate Parquet files
*.parquet
*.parquet.tmp
data/output/
data/intermediate/
data/temp/

# ------------------------------------------------------------------------------
# 5. Prefect 3 Runtime, Server & SQLite Databases
# ------------------------------------------------------------------------------
.prefect/
prefect.db
prefect.db-*
*.sqlite
*.sqlite3
*.sqlite3-journal
*.db
*.db-journal

# ------------------------------------------------------------------------------
# 6. Graphify Knowledge Graph Index & Caches
# ------------------------------------------------------------------------------
graphify-out/
.graphify/
*.graphify_version
.graphify_python
.graphify_root

# ------------------------------------------------------------------------------
# 7. Unit Tests, Coverage, Temporary Files & Caches
# ------------------------------------------------------------------------------
.cache/
.pytest_cache/
.pytest-tmp/
.hypothesis/
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
nosetests.xml
coverage.xml
*.cover
*.py.cover

# Profiling and performance traces
*.prof
*.pstats
benchmark_results/

# Linters and type checkers
.ruff_cache/
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/

# ------------------------------------------------------------------------------
# 8. IDEs, Text Editors & Developer Workspaces
# ------------------------------------------------------------------------------
# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.vscode/*.log
tempCodeRunnerFile.py

# JetBrains (PyCharm, IntelliJ)
.idea/
*.iws
*.iml
*.ipr

# Other editors
.spyderproject
.spyproject
.ropeproject
*.sublime-project
*.sublime-workspace
*~
*.swp
*.swo
*.bak

# AI agent local working directories (preserve committed skills & rules)
.claude/settings.local.json
.gemini/antigravity/

# ------------------------------------------------------------------------------
# 9. Operating System Files
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/

# Linux
.directory

# ------------------------------------------------------------------------------
# 10. General Logs & Scratch
# ------------------------------------------------------------------------------
*.log
*.tmp
*.temp
scratch/
tmp/
temp/
