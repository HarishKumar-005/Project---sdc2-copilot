# ==============================================================================
# SCD2 Copilot — Streamlit Secrets Template (.streamlit/secrets.toml)
# Copy this file to .streamlit/secrets.toml and fill in your values.
# NEVER commit .streamlit/secrets.toml to version control.
# ==============================================================================

# ── AI Provider API Keys ─────────────────────────────────────────────────────
# (Optional: if omitted, system falls back to rule-based template explanations)
GEMINI_API_KEY = "your-gemini-api-key-here"
GROQ_API_KEY = "your-groq-api-key-here"

# ── Supabase Auth & Database Configuration ────────────────────────────────────
# Supabase URL, publishable key, secret key, and database connection are configured
# in your environment or .env file (see .env.example).
#
# Authentication Authority: Supabase Auth (with Google OAuth provider).
# To configure Google OAuth for Supabase:
# 1. In Supabase Dashboard -> Authentication -> Providers -> Google:
#    Enable Google provider and provide Google Client ID & Secret.
# 2. In Google Cloud Console:
#    Add https://<project-ref>.supabase.co/auth/v1/callback to Authorized redirect URIs.
