# ==============================================================================
# SCD2 Copilot — Streamlit Secrets Template (.streamlit/secrets.toml)
# Copy this file to .streamlit/secrets.toml and fill in your values.
# NEVER commit .streamlit/secrets.toml to version control.
# ==============================================================================

# ── AI Provider API Keys ─────────────────────────────────────────────────────
# (Optional: if omitted, system falls back to rule-based template explanations)
GEMINI_API_KEY = "your-gemini-api-key-here"
GROQ_API_KEY = "your-groq-api-key-here"

# ── Streamlit Native OIDC Authentication (Google) ─────────────────────────────
# IMPORTANT FOR DEPLOYMENT (e.g. Streamlit Community Cloud):
# 1. Local development redirect_uri:
#    redirect_uri = "http://localhost:8501/oauth2callback"
# 2. Deployed cloud redirect_uri (e.g., https://sdc2-copilot.streamlit.app):
#    redirect_uri = "https://sdc2-copilot.streamlit.app/oauth2callback"
#
# IN GOOGLE CLOUD CONSOLE (APIs & Services -> Credentials -> OAuth 2.0 Client):
# - Authorized JavaScript origins:
#     http://localhost:8501
#     https://sdc2-copilot.streamlit.app
# - Authorized redirect URIs:
#     http://localhost:8501/oauth2callback
#     https://sdc2-copilot.streamlit.app/oauth2callback
#
# (Keep BOTH URIs listed in Google Cloud Console so both local dev and cloud work!)
[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "replace-with-a-random-32-byte-hex-or-base64-secret"

[auth.google]
client_id = "your-client-id.apps.googleusercontent.com"
client_secret = "your-google-client-secret"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
