# ==============================================================================
# SCD2 Copilot — Streamlit Secrets Template (.streamlit/secrets.toml)
# Copy this file to .streamlit/secrets.toml and fill in your values.
# NEVER commit .streamlit/secrets.toml to version control.
# ==============================================================================

# ── AI Provider API Keys ─────────────────────────────────────────────────────
# (Optional: if omitted, system falls back to rule-based template explanations)
GEMINI_API_KEY = "your-gemini-api-key-here"
GROQ_API_KEY = "your-groq-api-key-here"

# ── Streamlit Native OIDC Authentication (Google) ─────────────────────────────
# Local development callback: http://localhost:8501/oauth2callback
# Cloud deployment callback:  https://<your-app-domain>/oauth2callback
#
# Streamlit OIDC configuration standards:
# 1. Create OAuth 2.0 Client Credentials in Google Cloud Console
#    - Application Type: Web application
#    - Authorized redirect URIs: http://localhost:8501/oauth2callback (or your cloud domain)
# 2. Put shared cookie_secret and redirect_uri in [auth]
# 3. Put provider credentials in [auth.google] (or directly in [auth])
[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "replace-with-a-random-32-byte-hex-or-base64-secret"

[auth.google]
client_id = "your-client-id.apps.googleusercontent.com"
client_secret = "your-google-client-secret"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
